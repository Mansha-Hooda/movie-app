# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDb API key (https://www.themoviedb.org/settings/api) — server-only, never NEXT_PUBLIC_
TMDB_API_KEY=

# Gemini API key (https://aistudio.google.com/apikey) — server-only, never NEXT_PUBLIC_
GEMINI_API_KEY=

# Groq API key (https://console.groq.com/keys) — server-only fallback vision provider
GROQ_API_KEY=

# Supadata API key (https://dash.supadata.ai) — reel caption + transcript for /api/identify-reel
SUPADATA_API_KEY=
